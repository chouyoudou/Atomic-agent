# ASE MCP Server 环境配置文件示例
# 复制此文件为 .env 并根据需要修改配置

# ==================== 服务器配置 ====================

# Redis配置
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Web服务器配置
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEBSOCKET_PORT=8001

# 服务启用开关
ENABLE_MCP=true
ENABLE_WEB=true

# ==================== 安全配置 ====================

# 密钥配置
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# CORS配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==================== 数据库配置 ====================

# PostgreSQL配置（可选，用于更高级的用户管理）
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ==================== 日志配置 ====================

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE=ase_mcp.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# ==================== 性能配置 ====================

# 会话配置
SESSION_TIMEOUT=3600
MAX_SESSIONS_PER_USER=10
MAX_HISTORY_SIZE=50

# 计算配置
MAX_ATOMS_PER_STRUCTURE=10000
CALCULATION_TIMEOUT=300
MAX_CONCURRENT_CALCULATIONS=5

# WebSocket配置
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10
WS_MAX_CONNECTIONS=100

# ==================== 存储配置 ====================

# 文件存储
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=cif,xyz,pdb,mol,sdf,json

# 临时文件清理
TEMP_FILE_LIFETIME=3600
CLEANUP_INTERVAL=300

# ==================== 计算器配置 ====================

# 默认计算器
DEFAULT_CALCULATOR=emt

# 可用计算器列表
AVAILABLE_CALCULATORS=emt

# 计算器特定配置
EMT_ENABLED=true

# ==================== 前端配置 ====================

# React应用配置
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8001
REACT_APP_TITLE=ASE MCP Server
REACT_APP_VERSION=0.1.0

# 3D可视化配置
REACT_APP_MAX_ATOMS_RENDER=5000
REACT_APP_DEFAULT_ATOM_SCALE=1.0
REACT_APP_DEFAULT_BACKGROUND=#000000

# ==================== 开发配置 ====================

# 开发模式
DEBUG=false
DEVELOPMENT=false

# 热重载
HOT_RELOAD=false

# 性能分析
ENABLE_PROFILING=false
PROFILING_OUTPUT_DIR=./profiling

# API文档
ENABLE_DOCS=true
DOCS_URL=/docs

# ==================== 生产配置 ====================

# SSL证书（生产环境）
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=

# 反向代理配置
PROXY_PREFIX=
TRUST_PROXY=false

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_PATH=/health

# ==================== 云服务配置 ====================

# AWS S3配置（可选）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Docker配置
DOCKER_REGISTRY=
DOCKER_TAG=latest