# Dockerfile for ASE MCP Client
FROM node:18-alpine

# 设置工作目录
WORKDIR /app

# 复制package文件
COPY client/package*.json ./

# 安装依赖
RUN npm install

# 复制源代码
COPY client/ .

# 设置环境变量
ENV REACT_APP_API_URL=http://localhost:8000
ENV REACT_APP_WS_URL=ws://localhost:8001

# 构建应用
RUN npm run build

# 使用nginx提供静态文件服务
FROM nginx:alpine

# 复制构建产物
COPY --from=0 /app/build /usr/share/nginx/html

# 复制nginx配置
COPY client/nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 3000

# 启动nginx
CMD ["nginx", "-g", "daemon off;"]